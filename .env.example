DATABASE_URL=postgresql://cardapio:cardapio@localhost:5433/cardapio
PORT=3000
# Segredo do login da equipe (mínimo 32 caracteres). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SEGREDO=troque-por-um-segredo-de-32-caracteres-ou-mais
# Intervalo (ms) da verificação de chamados sem resposta; 0 desliga.
CHAMADOS_VERIFICAR_MS=5000
CENTRAL_VERIFICAR_MS=30000
# Web Push para o app do garçom (opcional). Gere com: pnpm --filter api vapid
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTATO=mailto:voce@exemplo.com
