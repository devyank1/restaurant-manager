generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoGrupoOpcao {
  UNICA
  MULTIPLA
  SABORES
}

model Restaurante {
  id                    String   @id @default(uuid())
  nome                  String
  slug                  String   @unique
  logoUrl               String?
  wifiSsid              String?
  wifiSenha             String?
  googleAvaliacaoUrl    String?
  /// Segundos sem leitura até o chamado passar para o próximo garçom.
  janelaChamadoSegundos Int      @default(60)
  criadoEm              DateTime @default(now())

  mesas       Mesa[]
  categorias  Categoria[]
  pratos      Prato[]
  gruposOpcao GrupoOpcao[]
  opcoes      Opcao[]
  usuarios    Usuario[]
  sessoes     SessaoMesa[]
  chamados    Chamado[]
  eventos     Evento[]
}

model Mesa {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  numero        Int
  token         String      @unique
  criadoEm      DateTime    @default(now())

  sessoes  SessaoMesa[]
  chamados Chamado[]

  @@unique([restauranteId, numero])
}

model Categoria {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome          String
  ordem         Int
  criadoEm      DateTime    @default(now())

  pratos Prato[]
}

model Prato {
  id                       String      @id @default(uuid())
  restauranteId            String
  restaurante              Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  categoriaId              String
  categoria                Categoria   @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  nome                     String
  descricao                String
  precoCentavos            Int
  precoPromocionalCentavos Int?
  destaque                 Boolean     @default(false)
  esgotado                 Boolean     @default(false)
  videoUrl                 String?
  posterUrl                String?
  ordem                    Int
  criadoEm                 DateTime    @default(now())

  grupos GrupoOpcao[]
}

model GrupoOpcao {
  id            String         @id @default(uuid())
  restauranteId String
  restaurante   Restaurante    @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  pratoId       String
  prato         Prato          @relation(fields: [pratoId], references: [id], onDelete: Cascade)
  nome          String
  tipo          TipoGrupoOpcao
  obrigatorio   Boolean
  min           Int
  max           Int
  ordem         Int
  criadoEm      DateTime       @default(now())

  opcoes Opcao[]
}

model Opcao {
  id                       String      @id @default(uuid())
  restauranteId            String
  restaurante              Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  grupoId                  String
  grupo                    GrupoOpcao  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nome                     String
  precoCentavos            Int
  precoPromocionalCentavos Int?
  ordem                    Int
  criadoEm                 DateTime    @default(now())
}

enum PapelUsuario {
  DONO
  GARCOM
  COZINHA
}

model Usuario {
  id              String       @id @default(uuid())
  restauranteId   String
  restaurante     Restaurante  @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  nome            String
  email           String       @unique
  senhaHash       String
  papel           PapelUsuario
  emTurno         Boolean      @default(false)
  emTurnoDesde    DateTime?
  ultimoChamadoEm DateTime?
  criadoEm        DateTime     @default(now())

  inscricoesPush InscricaoPush[]

  @@index([restauranteId])
}

enum StatusSessao {
  ABERTA
  FECHADA
}

model SessaoMesa {
  id            String       @id @default(uuid())
  restauranteId String
  restaurante   Restaurante  @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  mesaId        String
  mesa          Mesa         @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  status        StatusSessao @default(ABERTA)
  garcomId      String?
  garcomDesde   DateTime?
  abertaEm      DateTime     @default(now())
  fechadaEm     DateTime?

  dispositivos  DispositivoSessao[]
  itensCarrinho ItemCarrinho[]
  rodadas       Rodada[]
  chamados      Chamado[]

  @@index([mesaId, status])
}

model DispositivoSessao {
  id            String     @id @default(uuid())
  restauranteId String
  sessaoId      String
  sessao        SessaoMesa @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  dispositivoId String
  confirmado    Boolean    @default(false)
  entrouEm      DateTime   @default(now())

  @@unique([sessaoId, dispositivoId])
}

model ItemCarrinho {
  id            String     @id @default(uuid())
  restauranteId String
  sessaoId      String
  sessao        SessaoMesa @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  pratoId       String
  selecao       Json
  observacao    String     @default("")
  quantidade    Int
  adicionadoPor String
  criadoEm      DateTime   @default(now())
}

enum StatusRodada {
  AGUARDANDO_GARCOM
  CONFIRMADA
  CANCELADA
}

model Rodada {
  id              String       @id @default(uuid())
  restauranteId   String
  sessaoId        String
  sessao          SessaoMesa   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  dispositivoId   String
  status          StatusRodada
  totalCentavos   Int
  criadoEm        DateTime     @default(now())
  confirmadaEm    DateTime?
  confirmadaPorId String?

  itens ItemRodada[]
}

model ItemRodada {
  id                    String @id @default(uuid())
  restauranteId         String
  rodadaId              String
  rodada                Rodada @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  pratoId               String
  nome                  String
  resumoOpcoes          String
  selecao               Json
  observacao            String
  quantidade            Int
  precoUnitarioCentavos Int
}

enum TipoChamado {
  ATENDENTE
  CONFIRMAR_RODADA
}

enum StatusChamado {
  ABERTO
  LIDO
  RESOLVIDO
}

model Chamado {
  id            String        @id @default(uuid())
  restauranteId String
  restaurante   Restaurante   @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  mesaId        String
  mesa          Mesa          @relation(fields: [mesaId], references: [id], onDelete: Cascade)
  sessaoId      String
  sessao        SessaoMesa    @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  tipo          TipoChamado
  rodadaId      String?
  garcomId      String?
  status        StatusChamado @default(ABERTO)
  tentativas    Int           @default(1)
  paraTodos     Boolean       @default(false)
  criadoEm      DateTime      @default(now())
  atribuidoEm   DateTime      @default(now())
  lidoEm        DateTime?
  resolvidoEm   DateTime?

  @@index([restauranteId, status])
}

model Evento {
  id            String      @id @default(uuid())
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id], onDelete: Cascade)
  tipo          String
  dados         Json
  criadoEm      DateTime    @default(now())

  @@index([restauranteId, tipo])
}

model InscricaoPush {
  id            String   @id @default(uuid())
  restauranteId String
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  endpoint      String   @unique
  p256dh        String
  auth          String
  criadoEm      DateTime @default(now())
}
